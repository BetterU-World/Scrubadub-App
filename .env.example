# Convex
CONVEX_DEPLOYMENT=             # e.g. dev:your-project-123
VITE_CONVEX_URL=               # e.g. https://your-project-123.convex.cloud
VITE_ENABLE_DEMO_MODE=false    # set true only for local or protected preview builds
VITE_ENABLE_OPERATIONS_ASSESSMENT=false
# VITE_SENTRY_DSN=             # optional; omit for local QA

# Core Convex environment (set in Convex dashboard, not this local file)
TOKEN_PEPPER=                  # unique random value per deployment; never copy production
APP_URL=http://localhost:5173
SCRUB_DISABLE_EXTERNAL_SIDE_EFFECTS=true
# Guarded QA fixtures additionally require this exact opt-in. Never enable it
# for production or preview deployments.
SCRUB_QA_ENABLED=false

# Stripe (set in Convex dashboard → Environment Variables)
STRIPE_WEBHOOK_ACCOUNT_SECRET= # whsec_... from Stripe dashboard (account/platform webhook)
STRIPE_WEBHOOK_CONNECT_SECRET= # whsec_... from Stripe dashboard (connect webhook)
STRIPE_SECRET_KEY=             # sk_test_... or sk_live_...
STRIPE_PRICE_SCRUB_SOLO=       # Stripe price ID for Solo ($34.99/mo)
STRIPE_PRICE_SCRUB_TEAM=       # Stripe price ID for Team ($64.99/mo)
STRIPE_PRICE_SCRUB_PRO=        # Stripe price ID for Pro ($149.99/mo)
STRIPE_PRICE_SCRUB_PRO_LEGACY= # Legacy Pro price ID (grandfathered users)

# Email (optional; set only where outbound email is intentionally enabled)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Private manuals (optional)
BLOB_READ_WRITE_TOKEN=

# Optional routing/access lists
FOUNDER_EMAILS=
SUPERADMIN_EMAILS=
SUPPORT_DESTINATION_EMAIL=

# With SCRUB_DISABLE_EXTERNAL_SIDE_EFFECTS=true, email, Stripe, Blob reads,
# Stripe webhooks, and external calendar fetches are blocked even if configured.

{
  "trailingSlash": false,
  "functions": {
    "api/mini-site.ts": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/giveaway", "destination": "/giveaway/index.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/([^/.]+)/cleaner", "destination": "/api/mini-site?slug=$1&subpage=cleaner" },
    { "source": "/([^/.]+)", "destination": "/api/mini-site?slug=$1" },
    { "source": "/((?!robots\\.txt|sitemap\\.xml|favicon\\.ico|favicon\\.svg|site\\.webmanifest|manifest\\.json|assets/.*).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/r/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/c/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' blob: data: https:; connect-src 'self' https://*.convex.cloud https://*.convex.site wss://*.convex.cloud https://*.ingest.sentry.io https://api.stripe.com; frame-src https://js.stripe.com; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
